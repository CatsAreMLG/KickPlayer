<?xml version="1.0" encoding="utf-8"?>
<!-- Three layers stacked: the home screen, the player screen, and the video
     itself, which moves between expanded (top of the player screen), the
     floating mini player, and fullscreen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ===== Home screen ===== -->
    <ScrollView
        android:id="@+id/homeScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <!-- App logo -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:contentDescription="Kick Player"
                android:paddingVertical="4dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_kp" />

            <!-- Search -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_glass"
                android:orientation="vertical"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_input"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_search"
                        android:tint="@color/text_muted" />

                    <EditText
                        android:id="@+id/channelInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Channel or VOD link"
                        android:imeOptions="actionGo"
                        android:inputType="text"
                        android:singleLine="true"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_muted"
                        android:textSize="16sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/goButton"
                        style="@style/Pill"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_accent"
                        android:text="Watch"
                        android:textColor="#000000" />

                    <TextView
                        android:id="@+id/vodsButton"
                        style="@style/Pill"
                        android:layout_width="0dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_glass"
                        android:text="VODs"
                        android:textColor="@color/text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:paddingTop="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Pinned channels -->
            <TextView
                style="@style/SectionHeader"
                android:text="Pinned" />

            <HorizontalScrollView
                android:id="@+id/pinnedScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/pinnedRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/pinnedHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Long-press a channel below, or tap Pin under a stream, to keep it here."
                android:textColor="@color/text_muted"
                android:textSize="13sp" />

            <!-- Recently watched -->
            <TextView
                android:id="@+id/recentHeader"
                style="@style/SectionHeader"
                android:text="Recently watched" />

            <LinearLayout
                android:id="@+id/recentList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Leaves room so the mini player never covers the last row. -->
            <View
                android:id="@+id/homeBottomSpace"
                android:layout_width="match_parent"
                android:layout_height="24dp" />
        </LinearLayout>
    </ScrollView>

    <!-- ===== Player screen ===== -->
    <LinearLayout
        android:id="@+id/playerScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Navbar above the video. The logo goes back to the home screen,
             shrinking the video into the mini player. -->
        <LinearLayout
            android:id="@+id/playerNavbar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp">

            <ImageButton
                android:id="@+id/navHome"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:adjustViewBounds="true"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Home"
                android:paddingHorizontal="6dp"
                android:paddingVertical="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_kp" />
        </LinearLayout>

        <!-- Space the expanded video sits over. -->
        <View
            android:id="@+id/playerSlot"
            android:layout_width="match_parent"
            android:layout_height="200dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_glass"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/infoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="3"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/infoAvatar"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:importantForAccessibility="no" />

                        <TextView
                            android:id="@+id/infoStreamer"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/pinButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:background="@drawable/bg_pill_glass"
                            android:drawablePadding="6dp"
                            android:gravity="center"
                            android:paddingHorizontal="14dp"
                            android:text="Pin"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/infoDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/moreHeader"
                    style="@style/SectionHeader"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/moreList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- ===== The video (expanded, mini, or fullscreen) ===== -->
    <FrameLayout
        android:id="@+id/playerFrame"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_gravity="top"
        android:background="#000000"
        android:visibility="gone">

        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:show_buffering="when_playing" />

        <!-- Title across the top in fullscreen while the controls are showing. -->
        <TextView
            android:id="@+id/fullscreenTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:shadowColor="#E6000000"
            android:shadowRadius="8"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/seekBackHint"
            style="@style/GestureHint"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="48dp"
            android:text="« 10s" />

        <TextView
            android:id="@+id/seekForwardHint"
            style="@style/GestureHint"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="48dp"
            android:text="10s »" />

        <TextView
            android:id="@+id/zoomHint"
            style="@style/GestureHint"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="32dp" />

        <!-- Mini player: drag to move, tap to open, buttons to pause or close. -->
        <FrameLayout
            android:id="@+id/miniOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/miniPlayPause"
                style="@style/GlassIconButton"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="bottom|start"
                android:layout_margin="6dp"
                android:contentDescription="Play or pause"
                android:padding="6dp"
                android:src="@drawable/ic_pause" />

            <ImageButton
                android:id="@+id/miniClose"
                style="@style/GlassIconButton"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="top|end"
                android:layout_margin="6dp"
                android:contentDescription="Close player"
                android:padding="6dp"
                android:src="@drawable/ic_close" />
        </FrameLayout>
    </FrameLayout>
</FrameLayout>
